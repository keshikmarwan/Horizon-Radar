APP_NAME=Horizon Radar
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://horizon:horizon@localhost:5432/horizonradar
REDIS_URL=redis://localhost:6379/0
APP_BASE_URL=http://localhost:3000
SNAPSHOT_DIR=../runtime/snapshots
REPORT_DIR=../runtime/reports
HORIZON_MATCHER_DATA_DIR=./data/horizon_matcher
OPENAI_API_KEY=

# Local LLM via Ollama
OLLAMA_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_THINK=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_FALLBACK_MODEL=qwen3-embedding:4b
EMBEDDING_TIMEOUT=300
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CHARS=1800

# Cloud/OpenAI-compatible LLM
LLM_ENABLED=false
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=qwen/qwen-2.5-72b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1
